    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "skill-marketplace",
    "pluginPackage": "@red-hat-developer-hub/backstage-plugin-skill-marketplace-backend",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-skill-marketplace",
      "@red-hat-developer-hub/backstage-plugin-skill-marketplace-backend",
      "@red-hat-developer-hub/backstage-plugin-skill-marketplace-common"

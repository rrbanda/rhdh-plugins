    "@red-hat-developer-hub/backstage-plugin-skill-marketplace-common": "workspace:^",
    "ajv": "^8.17.1",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0",
    "js-yaml": "^4.1.0",
    "neo4j-driver": "^5.27.0",
    "node-fetch": "^2.7.0"
